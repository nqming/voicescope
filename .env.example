# Set these in your shell; the application does not automatically read .env.
VOICESCOPE_CONFIG=configs/default.json
VOICESCOPE_DINOV3_REPO=vendor/dinov3
VOICESCOPE_BACKBONE_WEIGHTS=checkpoints/dinov3_vits16.pth
VOICESCOPE_CHECKPOINT=
VOICESCOPE_DEVICE=cpu
# Web runtime (same-origin frontend + API).
HOST=127.0.0.1
PORT=8000
VOICESCOPE_VERSION=local
VOICESCOPE_ALLOWED_HOSTS=localhost,127.0.0.1
# Empty for same-origin. Optional exact origins separated by commas, no trailing /.
VOICESCOPE_CORS_ORIGINS=
VOICESCOPE_INFERENCE_PER_MINUTE=6
# Trust only the reverse proxy you control. Render sets * behind its ingress.
FORWARDED_ALLOW_IPS=127.0.0.1
